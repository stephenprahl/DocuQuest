// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  level     Int      @default(1)
  xp        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userProgress   UserProgress[]
  campaigns      Campaign[]
  userBadges     UserBadge[]
  userMilestones UserMilestone[]

  @@map("users")
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String
  theme       String
  sourceUrl   String?
  isPublic    Boolean  @default(true)
  createdBy   String
  qualityScore Int?
  isValidated Boolean  @default(false)
  validationData String? // JSON string for validation results
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  levels      Level[]
  userProgress UserProgress[]
  creator     User       @relation(fields: [createdBy], references: [id])

  @@map("campaigns")
}

model Level {
  id          String   @id @default(cuid())
  campaignId  String
  title       String
  type        String   // 'lesson' | 'quiz' | 'challenge' | 'boss'
  xp          Int
  order       Int
  content     String   // JSON string for flexible content storage
  
  // Relations
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  progress    UserProgress[]

  @@map("levels")
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  levelId    String
  completed  Boolean  @default(false)
  completedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@map("user_progress")
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String   // emoji or icon name
  color       String   // theme color for the badge
  category    String   // 'achievement', 'milestone', 'skill', 'special'
  requirement String   // JSON string describing the requirement
  xpReward    Int      @default(0)
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  earnedAt   DateTime @default(now())
  progress   Float    @default(0) // for progress-based badges (0-1)

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String
  targetValue Int      // the target value to reach
  category    String   // 'level', 'xp', 'campaigns', 'quests', 'streak'
  icon        String
  color       String
  rewards     String   // JSON string with rewards (xp, badges, etc)
  createdAt   DateTime @default(now())

  // Relations
  userMilestones UserMilestone[]

  @@map("milestones")
}

model UserMilestone {
  id           String    @id @default(cuid())
  userId       String
  milestoneId  String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  currentValue Int       @default(0)

  // Relations
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
  @@map("user_milestones")
}
